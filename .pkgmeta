package-as: Accountant_Classic

manual-changelog:
    filename: Docs/Revision.txt
    markup-type: plain

externals:
    Libs/LibStub: svn://svn.wowace.com/wow/libstub/mainline/tags/1.0
    Libs/CallbackHandler-1.0: svn://svn.wowace.com/wow/callbackhandler/mainline/trunk/CallbackHandler-1.0

ignore:
    - AccountantFrame-BotLeft.psd
    - AccountantFrame-BotRight.psd
    - AccountantFrame-TopLeft.psd
    - AccountantFrame-TopRight.psd

license-output: Docs/LICENSE.txt

enable-nolib-creation: no


