package-as: Accountant_Classic

manual-changelog:
    filename: Docs/Revision.txt
    markup-type: plain

license-output: Docs/LICENSE.txt

enable-nolib-creation: no

# configs for WowInterface
wowi-archive-previous: yes
wowi-create-changelog: no

