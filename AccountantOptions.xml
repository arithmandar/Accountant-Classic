<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ C:\Projects\WoW\Bin\Interface\FrameXML\UI.xsd">
	<Script file="AccountantOptions.lua"/>
	<Frame name="AccountantOptionsFrame" hidden="true">
		<Layers>
			<Layer level="ARTWORK">
				<FontString inherits="GameFontNormalLarge" text="ACCLOC_OPTS">
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="15" y="-15"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Frame name="$parentWeek" inherits="UIDropDownMenuTemplate" enableMouse="true">
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT">
						<Offset>
							<AbsDimension x="340" y="-65"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						<FontString name="$parentLabel" inherits="GameFontNormalSmall" text="ACCLOC_STARTWEEK">
							<Anchors>
								<Anchor point="BOTTOMLEFT" relativePoint="TOPLEFT">
									<Offset>
										<AbsDimension x="21" y="0"/>
									</Offset>
								</Anchor>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Scripts>
					<OnLoad>
						AccountantOptionsFrameWeek_Init();
					</OnLoad>
				</Scripts>
			</Frame>
			<CheckButton name="AccountantOptionsFrameToggleButton" inherits="InterfaceOptionsSmallCheckButtonTemplate">
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset>
							<AbsDimension x="20" y="-45"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						_G[self:GetName().."Text"]:SetText(ACCLOC_MINIBUT);
					</OnLoad>
					<OnClick>
						AccountantButton_Toggle();
					</OnClick>
				</Scripts>
			</CheckButton>
			<CheckButton name="AccountantOptionsFrameToggleMoneyOnMiniMap" inherits="InterfaceOptionsSmallCheckButtonTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="AccountantOptionsFrameToggleButton">
						<Offset>
							<AbsDimension x="10" y="-25"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						_G[self:GetName().."Text"]:SetText(ACCLOC_MINIBUTMONEY);
					</OnLoad>
					<OnClick>
						AccountantOptionsMoneyOnMinimap_Toggle();
					</OnClick>
				</Scripts>
			</CheckButton>
			<CheckButton name="AccountantOptionsFrameToggleSessionOnMiniMap" inherits="InterfaceOptionsSmallCheckButtonTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="AccountantOptionsFrameToggleMoneyOnMiniMap">
						<Offset>
							<AbsDimension x="0" y="-25"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						_G[self:GetName().."Text"]:SetText(ACCLOC_MINIBUTSESSINF);
					</OnLoad>
					<OnClick>
						AccountantOptionsSessionOnMinimap_Toggle();
					</OnClick>
				</Scripts>
			</CheckButton>
			<CheckButton name="AccountantOptionsFrameToggleMoneyDisplay" inherits="InterfaceOptionsSmallCheckButtonTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="AccountantOptionsFrameToggleSessionOnMiniMap">
						<Offset>
							<AbsDimension x="-10" y="-25"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						_G[self:GetName().."Text"]:SetText(ACCLOC_ONSCRMONEY);
					</OnLoad>
					<OnClick>
						AccountantMoneyInfoFrame_Toggle();
					</OnClick>
				</Scripts>
			</CheckButton>
			<CheckButton name="AccountantOptionsFrameToggleDisplayInstroTips" inherits="InterfaceOptionsSmallCheckButtonTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="AccountantOptionsFrameToggleMoneyDisplay">
						<Offset>
							<AbsDimension x="0" y="-25"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						_G[self:GetName().."Text"]:SetText(ACCLOC_INTROTIPS);
					</OnLoad>
					<OnEnter>
						GameTooltip:SetOwner(self, "ANCHOR_TOPRIGHT");
						GameTooltip:SetText(ACCLOC_INTROTIPS_TIP, nil, nil, nil, nil, 1);
					</OnEnter>
					<OnClick>
						AccountantOptionsIntroTip_Toggle();
					</OnClick>
				</Scripts>
			</CheckButton>
<!--			<Button name="AccountantOptionsFrameDone" inherits="OptionsButtonTemplate" text="ACCLOC_DONE">
				<Anchors>
					<Anchor point="BOTTOM">
						<Offset>
							<AbsDimension x="0" y="20"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						AccountantOptions_Toggle();
					</OnClick>
				</Scripts>
			</Button>-->
		</Frames>
		<Scripts>
			<OnLoad>
				AccountantOptions_OnLoad(self);
			</OnLoad>
			<OnShow>
				AccountantOptions_OnShow(self);
			</OnShow>
			<OnHide>
				AccountantOptions_OnHide(self);
			</OnHide>
		</Scripts>
	</Frame>
</Ui>
